# Copy to .env and restrict permissions: chmod 600 .env
# Leave the API key blank to enter it through the write-only settings UI.
AI_PROVIDER=openai
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# LM Studio: start its OpenAI-compatible server and load a model.
# AI_PROVIDER=local
# AI_API_BASE=http://host.docker.internal:1234/v1
# AI_API_KEY=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=5000
# Set true when serving over HTTPS (required outside localhost).
COOKIE_SECURE=false
